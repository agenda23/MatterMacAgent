{
  "name": "matter-mac-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "pnpm sidecar:build:stub && pnpm tauri dev",
    "tauri:build": "pnpm tauri build",
    "tauri:build:universal": "pnpm tauri build --target universal-apple-darwin",
    "sidecar:dev": "pnpm --filter @matter-mac-agent/sidecar dev",
    "sidecar:build": "pnpm --filter @matter-mac-agent/sidecar build",
    "sidecar:build:stub": "pnpm --filter @matter-mac-agent/sidecar build:stub",
    "typecheck": "tsc --noEmit && pnpm --filter @matter-mac-agent/sidecar typecheck"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
